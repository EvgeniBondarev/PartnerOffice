# Прод: фронтенд и API для браузера живут на одном адресе (partner-office.mpsuper.ru), nginx контейнера
# проксирует /partner-api в Studio2 (web/nginx/default.conf.template). Поэтому адрес API пустой: запросы идут на тот же origin
# и cookie сессии (SameSite=Strict) работает без CORS.
VITE_API_BASE_URL=
